NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Must exactly match the origin used in the browser. For an existing tunnel, set its current HTTPS origin before starting LightSync.
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=
# Optional PostgreSQL connection string. Configure in production to persist
# account sessions and saved show setups; active live rooms remain in memory.
DATABASE_URL=
# Server-side Google OAuth credentials. Keep the client secret private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; when blank, LightSync builds this from PUBLIC_BASE_URL.
# Production callback: https://crowdsync-lights.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=
LOG_LEVEL=info
MAX_ROOMS=100
MAX_AUDIENCE_PER_ROOM=2000
MAX_WEBSOCKET_CONNECTIONS=5000
SHOW_CONTROL_LEASE_MS=30000
ROOM_LOOKUPS_PER_MINUTE=300
OPERATOR_COMMANDS_PER_10_SECONDS=200
